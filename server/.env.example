# Database Configuration
DATABASE_URL=mongodb://localhost:27017/dukani_system

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_here_minimum_32_characters
REFRESH_TOKEN_SECRET=your_super_secure_refresh_token_secret_key_here_minimum_32_characters

# Server Configuration
PORT=3000
NODE_ENV=development

# Security Configuration
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900000
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# PII Encryption (AES-256-GCM at rest) — 32-byte key, 64 hex chars or base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production: customer phone/address is stored plaintext without it.
PII_ENCRYPTION_KEY=replace_with_64_hex_chars_from_the_generate_command_above

# Session Configuration
SESSION_SECRET=your_super_secure_session_secret_key_here_minimum_32_characters

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email Configuration — ZeptoMail (Zoho) SMTP
# Docs: https://www.zoho.com/zeptomail/help/smtp-access.html
EMAIL_HOST=smtp.zeptomail.com
EMAIL_PORT=587
EMAIL_USER=emailapikey
EMAIL_PASS=your_zeptomail_api_key_here
EMAIL_FROM="E-Shop — BHABY GROUP LTD" <noreply@bhabygroup.co.tz>
EMAIL_CC=arafat1421.lee@gmail.com
ADMIN_EMAIL=info@bhabygroup.co.tz

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379

# Backup Configuration (scripts/backup-database.js)
# BACKUP_DIR=./backups
# Encrypt backup archives with AES-256-CBC (openssl -pbkdf2). Generate with:
#   openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=
# Off-site copy targets (optional — set one to enable `push`)
# BACKUP_S3_BUCKET=s3://my-bucket/backups
# BACKUP_RCLONE_REMOTE=s3:my-bucket/backups

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# API Configuration
API_VERSION=v1
API_RATE_LIMIT=1000

# LLM Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Monitoring Configuration
SENTRY_DSN=your_sentry_dsn_here

# Business Configuration
DEFAULT_CURRENCY=TZS
DEFAULT_TAX_RATE=18
DEFAULT_TIMEZONE=Africa/Dar_es_Salaam

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ── Selcom Payment Gateway ────────────────────────────────────────────────
# Credentials issued by Selcom in their integration email. There is NO test
# mode — every API call moves real money, so verify with a small payment.
SELCOM_BASE_URL=https://apigw.selcommobile.com/v1
SELCOM_VENDOR=your_selcom_vendor_code
SELCOM_API_KEY=your_selcom_api_key
SELCOM_API_SECRET=your_selcom_api_secret
# Public HTTPS webhook URL. Defaults to <FRONTEND_URL>/api/public/payments/selcom/callback
SELCOM_CALLBACK_URL=
# Reject webhooks whose HMAC signature cannot be verified (keep true)
SELCOM_STRICT_WEBHOOK=true
# Pending payment sessions expire after this many minutes (default 15)
# SELCOM_SESSION_TTL_MINUTES=15